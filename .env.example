# ─────────────────────────────────────────────
#  Daawah Broadcast Engine — Environment Config
# ─────────────────────────────────────────────

# App
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Security — CHANGE THESE BEFORE DEPLOYMENT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
COOKIE_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET
CORS_ORIGIN=https://your-domain.com

# Database
DB_PATH=/opt/daawah-broadcast/data/daawah.db

# Media paths
MEDIA_LIBRARY_PATH=/media/library
MEDIA_EMERGENCY_PATH=/media/emergency
HLS_OUTPUT_PATH=/var/www/html/hls
LOG_PATH=/var/log/daawah-broadcast

# Data paths (relative to app root or absolute)
DATA_PATH=./data
ASSETS_PATH=./assets

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Broadcast profile
BROADCAST_RESOLUTION=1280x720
BROADCAST_FPS=25
BROADCAST_VIDEO_BITRATE=2500k
BROADCAST_AUDIO_BITRATE=192k
BROADCAST_AUDIO_RATE=48000
HLS_SEGMENT_DURATION=4
HLS_LIST_SIZE=10

# RTMP (optional)
RTMP_ENABLED=false
RTMP_URL=rtmp://live.example.com/live/streamkey

# Overlay config
OVERLAY_FONT_PATH=/opt/daawah-broadcast/assets/fonts/NotoSansArabic-Regular.ttf
OVERLAY_LOGO_LOOP_PATH=/opt/daawah-broadcast/assets/overlays/logo/logo-loop.webm
OVERLAY_LOGO_POSITION=10:10

# Ticker config
TICKER_HEIGHT=60
TICKER_FONT_SIZE=32
TICKER_TEXT_COLOR=#FFFFFF
TICKER_BG_COLOR=#00000099
TICKER_SPEED=80
TICKER_SAFE_MARGIN=20

# Now playing config
NOW_PLAYING_DURATION=10
NOW_PLAYING_FONT_SIZE=36
NOW_PLAYING_POSITION=left

# Playlist builder
PLAYLIST_BUILD_HOUR=23
PLAYLIST_LOOKAHEAD=3

# Professional gap filler
GAP_MAIN_STING_PATH=/srv/daawah/media/bumpers/logo-sting
GAP_SEASONAL_STING_PATH=/srv/daawah/media/bumpers/sting-hag
GAP_GENERAL_BUMPERS_PATH=/srv/daawah/media/bumpers/general
GAP_PATTERN=main,seasonal,general,general,general
GAP_MIN_FILL_MS=1000

# Read-only media browser
MEDIA_BROWSER_BASE_PATH=/srv/daawah/media
MEDIA_BROWSER_ALLOWED_ROOTS=original-ar,bumpers,emergency
MEDIA_BROWSER_STATS_FILE_LIMIT=10000

# Monitoring
HEALTH_CHECK_INTERVAL=30000
HLS_STALE_THRESHOLD=30

# Telegram alerts (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Transcode (manual only)
TRANSCODE_THREADS=2

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
